# JustOneLastDrink — Environment Variables
# Copy this to .env.local and fill in your values

# ============================================
# CONVEX (optional — app works without it)
# ============================================
# VITE_CONVEX_URL=https://your-project.convex.cloud

# ============================================
# NVIDIA AI Pipeline
# ============================================

# Get a free API key at https://build.nvidia.com
# VITE_NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pipeline mode — which AI model(s) to use:
#   "demo"         → No API key needed. Uses local random scoring (default)
#   "two-model"    → Kimi K2.5 (image analysis) → Nemotron-3-Nano (prediction)
#   "single-model" → Kimi K2.5 (image analysis + prediction in one call)
VITE_AI_PIPELINE=demo

# ============================================
# Pipeline Details
# ============================================
# 
# ┌─────────────────────────────────────────────────────────┐
# │ Option A: "two-model" (recommended)                     │
# │                                                         │
# │  Photo → Kimi K2.5 → Vision Signals → Nemotron → Card  │
# │          (analyze)                    (predict)         │
# │                                                         │
# │  • More control over each step                          │
# │  • Can tune vision vs prediction independently          │
# │  • Two API calls per prediction                         │
# ├─────────────────────────────────────────────────────────┤
# │ Option B: "single-model"                                │
# │                                                         │
# │  Photo → Kimi K2.5 → Analysis + Prediction → Card      │
# │          (both)                                         │
# │                                                         │
# │  • Simpler, one API call                                │
# │  • Less control but faster                              │
# │  • Good for prototyping                                 │
# ├─────────────────────────────────────────────────────────┤
# │ Option C: "demo" (default)                              │
# │                                                         │
# │  Photo → Local random scoring → Card                    │
# │                                                         │
# │  • No API key needed                                    │
# │  • Instant results with random data                     │
# │  • Great for development/testing                        │
# └─────────────────────────────────────────────────────────┘
