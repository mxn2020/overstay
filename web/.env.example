# JustOneLastDrink — Environment Variables
# Copy this to .env.local and fill in your values

# ============================================
# CONVEX (optional — app works without it)
# ============================================
# VITE_CONVEX_URL=https://your-project.convex.cloud

# ============================================
# NVIDIA AI Pipeline
# ============================================

# Get a free API key at https://build.nvidia.com
# This key is SERVER-ONLY — used by the Vite dev proxy, never sent to the browser
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pipeline mode (this one IS public, it's just a mode selector):
#   "demo"         → No API key needed. Uses local random scoring (default)
#   "two-model"    → Kimi K2.5 (image analysis) → Nemotron-3-Nano (prediction)
#   "single-model" → Kimi K2.5 (image analysis + prediction in one call)
VITE_AI_PIPELINE=demo

# ============================================
# Architecture
# ============================================
#
# Browser → /api/nvidia (Vite proxy) → NVIDIA NIM API
#                ↑
#       NVIDIA_API_KEY injected here (server-side only)
#
# In production, replace the proxy with Convex actions
# or a serverless function (Vercel/Netlify).
